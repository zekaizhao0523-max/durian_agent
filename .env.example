# Agent 模式：langgraph（大模型+LangGraph）| rules（规则模板，无需 Key）
AGENT_MODE=langgraph

# ========== DeepSeek（推荐，OpenAI 兼容接口）==========
# 密钥获取：https://platform.deepseek.com/api_keys
OPENAI_API_KEY=sk-你的deepseek密钥
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 其他模型示例（取消注释即可切换）
# 通义：OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  OPENAI_MODEL=qwen-plus
# OpenAI：OPENAI_BASE_URL=https://api.openai.com/v1  OPENAI_MODEL=gpt-4o-mini

# 工具适配：mock（默认）| http（预留真实 API）
TOOL_ADAPTER=mock
TRACE_API_BASE_URL=
MALL_API_BASE_URL=
ORDER_API_BASE_URL=

# 服务与存储
HOST=127.0.0.1
PORT=8080
# PostgreSQL（必填）
DATABASE_URL=postgresql://postgres:你的密码@localhost:5432/durian_agent
# 一键初始化: .\scripts\setup_postgres.ps1 -Password "你的密码"
# 或: python scripts/init_postgres.py --create-db
GRAPH_RECURSION_LIMIT=12
MAX_HISTORY_TURNS=10

# 默认用户名（前端未本地指定时生效；记忆与历史按 user_id 隔离）
DEFAULT_USER_ID=demo_user
